// Prisma Schema for SyncBoard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PRIVATE
  PUBLIC
}

enum RoomRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum BoardType {
  INFINITE
  SLIDES
}

// User
model User {
  id String @id @default(cuid())

  // Clerk
  clerkId String @unique

  // Identity
  email    String  @unique
  username String? @unique

  // Profile
  firstName   String?
  lastName    String?
  displayName String?
  imageUrl    String?

  // Status
  isActive Boolean @default(true)

  // Relations
  ownedRooms    Room[]       @relation("RoomOwner")
  memberships   RoomMember[]
  createdBoards Board[]      @relation("BoardCreator")

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Room
model Room {
  id String @id @default(cuid())

  name     String
  slug     String @unique
  roomCode String @unique

  description String?
  thumbnail   String?

  visibility RoomVisibility @default(PRIVATE)
  // Session state (used by realtime collaboration)
  isSessionActive Boolean         @default(true)

  ownerId String
  owner   User   @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  memberships RoomMember[]
  boards      Board[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("rooms")
}

model RoomMember {
  id String @id @default(cuid())

  roomId String
  userId String

  role RoomRole @default(VIEWER)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([role])
  @@map("room_members")
}

// Board model
model Board {
  id String @id @default(cuid())

  roomId String

  createdById String

  name String

  description String?

  type BoardType

  settings Json

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdBy User @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)

  pages BoardPage[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([roomId, name])
  @@index([roomId])
  @@index([createdById])
  @@map("boards")
}

// board page
model BoardPage {
  id String @id @default(cuid())

  boardId String

  pageNumber Int

  title String?

  canvasData Json

  version Int @default(1)

  thumbnailUrl String?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([boardId, pageNumber])
  @@index([boardId])
  @@map("board_pages")
}
